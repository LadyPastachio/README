# Example environment file. Copy to `.env.local` and fill in values.
# Never commit real secrets. `.env.local` is ignored by git.
#
# Read only by the local AI server (`npm run server`), never by the browser.
# Vite only exposes variables that start with VITE_, and none of these do.
# Without a key the app works fully, with simulated AI responses.
ANTHROPIC_API_KEY=
# AI_MODEL=claude-opus-5-5        # or claude-haiku-5-5 for a much cheaper option
# AI_DAILY_LIMIT=50               # requests per day before the server refuses
# AI_MAX_TOKENS=1024              # longest answer, in tokens
# PORT=8787
